+//! File-backed `CFReadStream` support.
+//!
+//! CF streams are toll-free bridged with NS streams on Apple platforms.  Old
+//! iOS games also use the C API directly, so provide the small synchronous,
+//! file-backed subset here on top of touchHLE's virtual POSIX filesystem.
+
+use super::cf_allocator::{kCFAllocatorDefault, CFAllocatorRef};
+use super::{CFIndex, CFTypeRef};
+use crate::dyld::{export_c_func, FunctionExports};
+use crate::frameworks::foundation::ns_string::{from_rust_string, to_rust_string};
+use crate::libc::posix_io;
+use crate::mem::{MutPtr, Ptr};
+use crate::objc::{id, msg, objc_classes, release, ClassExports, HostObject};
+use crate::Environment;
+
+pub type CFReadStreamRef = CFTypeRef;
+type CFStreamStatus = CFIndex;
+
+const K_CF_STREAM_STATUS_NOT_OPEN: CFStreamStatus = 0;
+const K_CF_STREAM_STATUS_OPEN: CFStreamStatus = 2;
+const K_CF_STREAM_STATUS_READING: CFStreamStatus = 3;
+const K_CF_STREAM_STATUS_AT_END: CFStreamStatus = 5;
+const K_CF_STREAM_STATUS_CLOSED: CFStreamStatus = 6;
+const K_CF_STREAM_STATUS_ERROR: CFStreamStatus = 7;
+
+struct CFReadStreamHostObject {
+    path: String,
+    fd: posix_io::FileDescriptor,
+    status: CFStreamStatus,
+}
+impl HostObject for CFReadStreamHostObject {}
+
+fn CFReadStreamCreateWithFile(
+    env: &mut Environment,
+    allocator: CFAllocatorRef,
+    file_url: CFTypeRef,
+) -> CFReadStreamRef {
+    // Core Foundation accepts NULL here as another spelling of the default
+    // allocator. Do not try to dereference it as a CFAllocator object.
+    assert!(
+        allocator.is_null()
+            || allocator == kCFAllocatorDefault
+            || env.mem.read(allocator).is_system_default()
+    ); // custom allocators are unimplemented
+    if file_url.is_null() {
+        return Ptr::null();
+    }
+
+    let path: id = msg![env; file_url path];
+    if path.is_null() {
+        return Ptr::null();
+    }
+    let path = to_rust_string(env, path).into_owned();
+    let host_object = Box::new(CFReadStreamHostObject {
+        path,
+        fd: -1,
+        status: K_CF_STREAM_STATUS_NOT_OPEN,
+    });
+    let class = env
+        .objc
+        .get_known_class("_touchHLE_CFReadStream", &mut env.mem);
+    env.objc.alloc_object(class, host_object, &mut env.mem)
+}
+
+fn CFReadStreamOpen(env: &mut Environment, stream: CFReadStreamRef) -> bool {
+    let (path, status) = {
+        let stream = env.objc.borrow::<CFReadStreamHostObject>(stream);
+        (stream.path.clone(), stream.status)
+    };
+    if status == K_CF_STREAM_STATUS_OPEN || status == K_CF_STREAM_STATUS_READING {
+        return true;
+    }
+    if status != K_CF_STREAM_STATUS_NOT_OPEN {
+        return false;
+    }
+
+    let path_string = from_rust_string(env, path);
+    let path_c_string = msg![env; path_string UTF8String];
+    let fd = posix_io::open_direct(env, path_c_string, posix_io::O_RDONLY);
+    release(env, path_string);
+
+    let stream = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+    stream.fd = fd;
+    stream.status = if fd == -1 {
+        K_CF_STREAM_STATUS_ERROR
+    } else {
+        K_CF_STREAM_STATUS_OPEN
+    };
+    fd != -1
+}
+
+fn CFReadStreamRead(
+    env: &mut Environment,
+    stream: CFReadStreamRef,
+    buffer: MutPtr<u8>,
+    buffer_length: CFIndex,
+) -> CFIndex {
+    if buffer_length < 0 {
+        return -1;
+    }
+    let fd = {
+        let stream = env.objc.borrow::<CFReadStreamHostObject>(stream);
+        if stream.status != K_CF_STREAM_STATUS_OPEN
+            && stream.status != K_CF_STREAM_STATUS_READING
+        {
+            return -1;
+        }
+        stream.fd
+    };
+
+    let bytes_read = posix_io::read(
+        env,
+        fd,
+        buffer.cast(),
+        buffer_length.try_into().unwrap(),
+    );
+    let stream = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+    if bytes_read < 0 {
+        stream.status = K_CF_STREAM_STATUS_ERROR;
+        -1
+    } else if bytes_read == 0 {
+        stream.status = K_CF_STREAM_STATUS_AT_END;
+        0
+    } else {
+        stream.status = K_CF_STREAM_STATUS_READING;
+        bytes_read.try_into().unwrap()
+    }
+}
+
+fn CFReadStreamHasBytesAvailable(env: &mut Environment, stream: CFReadStreamRef) -> bool {
+    let status = env
+        .objc
+        .borrow::<CFReadStreamHostObject>(stream)
+        .status;
+    status == K_CF_STREAM_STATUS_OPEN || status == K_CF_STREAM_STATUS_READING
+}
+
+fn CFReadStreamGetStatus(
+    env: &mut Environment,
+    stream: CFReadStreamRef,
+) -> CFStreamStatus {
+    env.objc
+        .borrow::<CFReadStreamHostObject>(stream)
+        .status
+}
+
+fn CFReadStreamCopyError(_env: &mut Environment, _stream: CFReadStreamRef) -> CFTypeRef {
+    // TODO: construct a CFError containing the virtual filesystem's errno.
+    Ptr::null()
+}
+
+fn CFReadStreamClose(env: &mut Environment, stream: CFReadStreamRef) {
+    let fd = env.objc.borrow::<CFReadStreamHostObject>(stream).fd;
+    if fd != -1 {
+        posix_io::close(env, fd);
+    }
+    let stream = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+    stream.fd = -1;
+    stream.status = K_CF_STREAM_STATUS_CLOSED;
+}
+
+pub const FUNCTIONS: FunctionExports = &[
+    export_c_func!(CFReadStreamCreateWithFile(_, _)),
+    export_c_func!(CFReadStreamOpen(_)),
+    export_c_func!(CFReadStreamRead(_, _, _)),
+    export_c_func!(CFReadStreamHasBytesAvailable(_)),
+    export_c_func!(CFReadStreamGetStatus(_)),
+    export_c_func!(CFReadStreamCopyError(_)),
+    export_c_func!(CFReadStreamClose(_)),
+];
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation _touchHLE_CFReadStream: NSObject
+
+- (())dealloc {
+    let fd = env.objc.borrow::<CFReadStreamHostObject>(this).fd;
+    if fd != -1 {
+        posix_io::close(env, fd);
+    }
+    env.objc.dealloc_object(this, &mut env.mem)
+}
+
+@end
+
+};
